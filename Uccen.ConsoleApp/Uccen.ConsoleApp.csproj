<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Hussein Arbaoui.xlsx" />
    <None Remove="uccen.pptx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Hussein Arbaoui.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\pptx\uccen.pptx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
	<EmbeddedResource Include="Resources\pptx\uccen.arb.pptx">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</EmbeddedResource>
	<EmbeddedResource Include="Resources\pptx\uccen.arq.pptx">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</EmbeddedResource>
	<EmbeddedResource Include="Resources\pptx\uccen.eng.pptx">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</EmbeddedResource>	
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

	<ItemGroup>
		<!-- All MIT-licensed. RichTextKit targets SkiaSharp 2.88.x, so keep SkiaSharp on 2.88. -->
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="Topten.RichTextKit" Version="0.4.167" />
	</ItemGroup>

</Project>
